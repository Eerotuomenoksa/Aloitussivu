{
  "name": "aloitussivu",
  "private": true,
  "version": "0.74.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cloudcity": "vite build --mode cloudcity",
    "build:staging": "vite build --mode staging",
    "build:firebase-rollback": "vite build --mode firebase-rollback",
    "build:local-provider": "vite build --mode local-provider",
    "package:rel10-staging": "powershell -ExecutionPolicy Bypass -File scripts/build-rel10-staging-package.ps1",
    "package:rel11-staging": "powershell -ExecutionPolicy Bypass -File scripts/build-rel11-staging-package.ps1",
    "package:production-path": "powershell -ExecutionPolicy Bypass -File scripts/build-production-path-package.ps1",
    "links": "node scripts/update-links.mjs",
    "visual-check": "node scripts/visual-check.mjs",
    "municipality-locales": "node scripts/update-municipality-website-locales.mjs",
    "newspapers": "node scripts/update-newspapers.mjs",
    "newspaper-feeds": "node scripts/update-newspaper-feeds.mjs",
    "refresh:links": "npm run links",
    "refresh:generated": "npm run links && npm run changelog",
    "refresh:newspapers": "npm run newspapers && npm run newspaper-feeds",
    "refresh:data": "npm run refresh:newspapers && npm run regional-coverage && npm run refresh:generated",
    "regional-coverage": "node scripts/update-regional-link-coverage.mjs && node scripts/update-news-feed-coverage.mjs",
    "senior-pages": "node scripts/discover-municipality-senior-links.mjs",
    "senior-coverage": "node scripts/update-senior-page-coverage.mjs",
    "community-coverage": "node scripts/update-community-link-coverage.mjs",
    "population-context": "node scripts/update-municipality-population-context.mjs",
    "changelog": "node scripts/update-changelog.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "release:prepare": "npm run version:bump && npm run changelog",
    "check:secrets": "node scripts/check-no-hardcoded-secrets.mjs",
    "rel08:test": "node scripts/rel08-migration-test.mjs",
    "rel08:export": "node scripts/rel08-export-firestore.mjs",
    "rel08:build-import": "node scripts/rel08-build-import.mjs",
    "rel11:build-admin-provisioning": "node scripts/rel11-build-admin-provisioning.mjs",
    "rel11:admin-provisioning-test": "node scripts/rel11-admin-provisioning-test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@google/genai": "latest",
    "fast-xml-parser": "^5.8.0",
    "firebase": "^12.12.1",
    "node-html-parser": "^6.1.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.60.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
