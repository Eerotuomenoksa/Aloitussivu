rules_version = '2';

// REL-11-tuotantovaihdon kirjoituslukko.
// Julkiset lukureitit säilyvät, mutta kaikki asiakas- ja ylläpitokirjoitukset
// estetään. Admin SDK -vienti käyttää IAM-tunnistusta ja ohittaa nämä säännöt.
service cloud.firestore {
  match /databases/{database}/documents {
    match /feedbackItems/{feedbackId} {
      allow read: if true;
      allow write: if false;
    }

    match /approvedLinks/{linkId} {
      allow read: if true;
      allow write: if false;
    }

    match /blockedLinks/{linkId} {
      allow read: if true;
      allow write: if false;
    }

    match /scamAlerts/{alertId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
